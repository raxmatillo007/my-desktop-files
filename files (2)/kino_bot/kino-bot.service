# /etc/systemd/system/kino-bot.service ga nusxalang, yo'llarni o'zingizniki qilib o'zgartiring
[Unit]
Description=Kino Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/kino_bot
ExecStart=/opt/kino_bot/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
