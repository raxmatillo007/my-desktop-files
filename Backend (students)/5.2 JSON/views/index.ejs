<!DOCTYPE html>
<html lang="uz">

<head>
  <title>Taco Retseptlari</title>
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
</head>

<body>
  <h1>Taco Shahri 🌮</h1>

  <form action="/recipe" method="POST" class="buttons">
    <button type="submit" value="tovuq" name="choice">🍗</button>
    <button type="submit" value="gosht" name="choice">🥩</button>
    <button type="submit" value="baliq" name="choice">🐟</button>
  </form>

  <div id="recipeContainer" class="hidden">
    <%if (locals.recipe) {%>

      <h2 id="recipeTitle">
        <%= recipe.name %>
      </h2>

      <h3>Tarkibi:</h3>
      <ul id="ingredientsList">
        <li>
          <%= recipe.ingredients.protein.name %>, <%= recipe.ingredients.protein.preparation %>
        </li>
        <li>
          <%= recipe.ingredients.salsa.name %>
        </li>
        <% recipe.ingredients.toppings.forEach(topping=> { %>
          <li>
            <%= topping.quantity %> miqdorida <%= topping.name %>
          </li>
          <% }) %>
      </ul>

      <%} else {%>
        <h2>Sevimli taco turini tanlang 👆</h2>
        <%}%>
  </div>
</body>

</html>
